# --- Postgres -------------------------------------------------------------
# Local Postgres.app cluster. Change host/port when this moves to a server.
DATABASE_URL=postgresql:///personalization

# --- Ellington ------------------------------------------------------------
# HTTP Basic auth against the ADG Ellington REST API.
ELLINGTON_BASE_URL=https://www.arkansasonline.com/api
ELLINGTON_TOKEN=
ELLINGTON_USERNAME=
ELLINGTON_PASSWORD=
# Publication status to fetch. On this install status=1 is the live state
# (the MCP docs' 1=Draft/3=Published mapping does not hold here).
ELLINGTON_STATUS=1
# Section front the editor picks come from: its lead_story plus
# additional_stories, in the order the desk set them.
EDITOR_SECTION_FRONT=186
# Optional: restrict to one site id in a multi-site install. Blank = no filter.
ELLINGTON_SITE_ID=
# Timezone used to interpret --hours / --since window boundaries.
ELLINGTON_TZ=America/Chicago

# --- OpenAI ---------------------------------------------------------------
OPEN_AI_TOKEN=
EMBED_MODEL=text-embedding-3-large
# Truncated (Matryoshka) to stay compatible with users.interest vector(1536).
EMBED_DIMENSIONS=1536

# --- Treasure Data (read-only) --------------------------------------------
TD_API_KEY=
TD_ENDPOINT=https://api.treasuredata.com
POPULARITY_WINDOW_HOURS=24
POPULARITY_PUBLISHED_WITHIN_HOURS=48
# raw_web.pageviews covers every WEHCO title; without this filter roughly 70%
# of counted volume is other papers. Add www.wholehogsports.com to include
# ADG's sports vertical.
POPULARITY_HOSTS=www.arkansasonline.com

# --- Matching -------------------------------------------------------------
# Trailing window used to compute the corpus mean vector (for mean-centering).
CORPUS_MEAN_WINDOW_DAYS=30

# --- Serving (Django Connected Content endpoint) --------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
ALLOWED_HOSTS=personalized.arkansasonline.com,localhost,127.0.0.1
# Shared secret Braze sends as the X-Feed-Token header. Leave blank in dev
# to disable the check; ALWAYS set it in production.
FEED_TOKEN=
# Set this to key the feed on sha256(salt || email) instead of the raw
# address, keeping emails out of URLs, logs and referrer headers.
FEED_HASH_SALT=
DB_STATEMENT_TIMEOUT_MS=500
EDITION_CACHE_SECONDS=30
CONN_MAX_AGE=60
